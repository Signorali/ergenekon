# =============================================================================
#  Ergenekon — Ana Konfigürasyon Şablonu
#  Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#    cp .env.example .env
# =============================================================================

# ── Uygulama Versiyonu ────────────────────────────────────────────────────────
APP_VERSION=3.3.1

# ── Veritabanı ────────────────────────────────────────────────────────────────
DB_NAME=ergenekon
DB_USER=postgres
DB_PASSWORD=BURAYA_GUCLU_SIFRE_GIR         # Zorunlu — örn. openssl rand -base64 32
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=BURAYA_GUCLU_SIFRE_GIR      # Zorunlu — örn. openssl rand -hex 24
REDIS_PORT=6379

# ── Servisler Arası Güvenlik ─────────────────────────────────────────────────
# Umay ↔ Ötüken iç API anahtarı — her iki serviste de aynı değer olmalı
INTERNAL_API_KEY=BURAYA_GUCLU_API_KEY_GIR  # Zorunlu — örn. openssl rand -hex 32

# ── Port Haritası ─────────────────────────────────────────────────────────────
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_OTUKEN_PORT=4443
UMAY_BACKEND_PORT=1923
UMAY_FRONTEND_PORT=1881
OTUKEN_BACKEND_PORT=8080
OTUKEN_FRONTEND_PORT=5174
UPTIME_KUMA_PORT=3001
